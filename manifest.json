{
  "manifest_version": 1,
  "name": "hermes-feishu-zh",
  "version": "0.4.0",
  "description": "Hermes Agent v0.20.0 飞书中文化与实时显示包。提供 102 条中文化规则、真实运行状态卡和单卡累积工具进度。",
  "license": "MIT",
  "homepage": "https://github.com/OLDBAI213/hermes-feishu-zh",
  "status": "compatible_on_local_hermes_0.20.0",
  "target": {
    "product": "Hermes Agent",
    "version_range": ">=0.20.0",
    "platforms": [
      "windows"
    ]
  },
  "profiles": {
    "stable": {
      "default": true,
      "description": "合并中文化与安静实时显示配置，安装 lark-cli 工具箱，并应用 v0.20.0 中文化和实时卡片补丁。"
    },
    "enhanced": {
      "default": false,
      "description": "在稳定版基础上增加更长的工具预览；实时状态卡和执行过程卡在两个配置中均启用。"
    }
  },
  "entrypoints": {
    "install": "install.ps1",
    "verify": "verify.ps1",
    "rollback": "install.ps1 -Rollback latest",
    "uninstall": "install.ps1 -Uninstall"
  },
  "modifies": {
    "config": [
      "config.yaml"
    ],
    "plugins": [
      "plugins/lark-cli-toolbox"
    ],
    "source_optional": [
      "hermes-agent/plugins/platforms/feishu/adapter.py",
      "hermes-agent/plugins/platforms/feishu/feishu_comment.py",
      "hermes-agent/plugins/platforms/feishu/feishu_comment_rules.py",
      "hermes-agent/plugins/platforms/feishu/feishu_meeting_invite.py",
      "hermes-agent/gateway/run.py",
      "hermes-agent/gateway/turn_context.py",
      "hermes-agent/gateway/feishu_realtime_display.py"
    ],
    "audit_assets": [
      "hermes-agent/scripts/feishu_localization_audit.py",
      "hermes-agent/locales/feishu_zh_audit_allowlist.yaml"
    ]
  },
  "backup": {
    "directory": "backups/hermes-feishu-zh-<timestamp>",
    "files": [
      "config.yaml",
      ".env",
      "plugins/lark-cli-toolbox",
      "patched source files"
    ]
  },
  "verify": {
    "command": "pwsh -NoProfile -File .\\verify.ps1",
    "checks": [
      "Hermes CLI resolves",
      "display.language == zh",
      "Feishu realtime_cards is enabled and tool progress accumulates",
      "Runtime footer, long-running bubbles, and detailed busy acknowledgements are disabled",
      "Realtime renderer exists and all v0.20.0 display patch markers are present",
      "lark-cli-toolbox plugin loads",
      "lark_cli tools are registered",
      "Feishu source Chinese labels and compact mobile markers are present",
      "Feishu user-visible English localization audit has zero unapproved items",
      "MEDIA path parsing keeps attachments out of message text",
      "lark-cli doctor passes when installed",
      "gateway_state is running and feishu is connected when gateway is enabled"
    ]
  },
  "does_not_contain": [
    "FEISHU_APP_ID",
    "FEISHU_APP_SECRET",
    "FEISHU_ALLOWED_USERS",
    "XIAOMI_API_KEY",
    "API keys",
    "tokens"
  ]
}
